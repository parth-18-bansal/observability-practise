{
  "title": "Orders API — RED",
  "panels": [
    { "type": "timeseries", "title": "Rate (req/s) by route",
      "targets": [{ "expr":
        "sum by (route) (rate(http_requests_total[5m]))" }] },
    { "type": "stat", "title": "Error ratio (4xx)",
      "fieldConfig": { "defaults": { "unit": "percentunit",
        "thresholds": { "steps": [
          {"color":"green","value":null},
          {"color":"red","value":0.01}] } } },
      "targets": [{ "expr":
        "sum(rate(http_requests_total{status=~\"4..\"}[5m])) / sum(rate(http_requests_total[5m]))" }] },
    { "type": "timeseries", "title": "Duration p50/p95/p99 (s)",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "legendFormat":"p50", "expr":"histogram_quantile(0.50, sum by (le)(rate(http_request_duration_seconds_bucket[5m])))" },
        { "legendFormat":"p95", "expr":"histogram_quantile(0.95, sum by (le)(rate(http_request_duration_seconds_bucket[5m])))" },
        { "legendFormat":"p99", "expr":"histogram_quantile(0.99, sum by (le)(rate(http_request_duration_seconds_bucket[5m])))" } ] }
  ]
}